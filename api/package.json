{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "Azure Functions API for Fluxline Pro",
  "main": "contact/index.js",
  "scripts": {
    "start": "func start",
    "test": "jest",
    "test:unit": "jest",
    "test:integration": "node test-contact.js"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.0",
    "@azure/storage-blob": "^12.26.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!test-contact.js",
      "!**/node_modules/**"
    ]
  }
}
