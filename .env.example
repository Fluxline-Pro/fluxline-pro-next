# Fluxline Pro Next.js - Frontend Environment Variables
# 
# This file contains FRONTEND ONLY configuration for the Next.js application.
# Backend/Azure Functions configuration is in api/local.settings.json
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the build and sent to the browser.
# Do NOT include sensitive secrets here.

# ===================================
# BUILD-TIME (Embedded in Frontend)
# ===================================
# These variables are embedded at build time and become visible in browser
# NEVER put secrets here

# Environment identifier (dev, test, prod)
# - 'dev' = Token auth required via /api/auth/validate-token
# - 'test' = Token auth required via /api/auth/validate-token
# - 'prod' = No token auth (public access)
NEXT_PUBLIC_ENVIRONMENT=prod

# reCAPTCHA v3 site key (public)
# Get at: https://www.google.com/recaptcha/admin
# Example: NEXT_PUBLIC_RECAPTCHA_SITE_KEY=site-key-placeholder
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=site-key-placeholder

# API base URL for frontend requests to Azure Functions
# IMPORTANT: Must match API_BASE_URL in api/local.settings.json for consistency
# 
# Local dev: http://localhost:7071 (Azure Functions Core Tools port)
#   - Run Azure Functions locally: cd api && func start
#   - Frontend will POST to http://localhost:7071/api/contact
#
# Deployed (Azure SWA): Leave EMPTY string
#   - Static Web Apps automatically proxies /api/* to Azure Functions
#   - Frontend will use relative path /api/contact
NEXT_PUBLIC_API_BASE_URL=http://localhost:7071

# ===================================
# DEPLOYMENT URLS
# ===================================
# Used by frontend for redirects, meta tags, etc.
# Examples:
#   Local: http://localhost:3000
#.  Dev: https://flx-next-dev.fluxline.pro
#   Test: https://flx-next-test.fluxline.pro
#   Prod: https://fluxline.pro
SITE_URL=https://fluxline.pro

# ===================================
# FLUXLINE ECOSYSTEM SIGN-IN (MSAL / Entra)
# ===================================
# Shared Entra app registration used by every Fluxline site
# (www.fluxline.pro, account.fluxline.pro, CMS, storefront).
# Powers the header avatar / "Sign in" control.
# These are PUBLIC identifiers, not secrets.

# Entra app registration (client) ID — same value across all Fluxline apps
NEXT_PUBLIC_MSAL_CLIENT_ID=

# Entra authority URL, e.g.
#   https://login.microsoftonline.com/<tenant-id>
#   or CIAM: https://<tenant>.ciamlogin.com/<tenant-id>
NEXT_PUBLIC_MSAL_AUTHORITY=

# Fluxline account portal URL ("My Account" link in the header avatar menu)
# Defaults to https://account.fluxline.pro when unset
NEXT_PUBLIC_ACCOUNT_URL=https://account.fluxline.pro

# ===================================
# BUILD-TIME SERVER-ONLY (GitHub page)
# ===================================
# Optional: raises the GitHub API rate limit when building the /github page.
# Read at build time only (Server Components) — NOT embedded in the browser
# bundle. GITHUB_TOKEN is preferred; GITHUB_API_TOKEN is a fallback alias.
# GITHUB_TOKEN=
# GITHUB_API_TOKEN=

# ===================================
# ANALYTICS & CONSENT
# ===================================
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
# Obtain from: https://analytics.google.com → Admin → Data Streams
# Leave empty to disable GA tracking (no script will be injected).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===================================
# LEAD CAPTURE (Phase 2 - Consultation Stepper)
# ===================================
# Do not expose a lead API secret via NEXT_PUBLIC_* variables.
# Protect /api/lead with function-side LEAD_ALLOWED_ORIGINS and
# LEAD_RATE_LIMIT_* settings instead.
