# Fluxline Pro Next.js Environment Variables

# ===================================
# BUILD-TIME ENVIRONMENT CONFIGURATION
# ===================================
# These variables are embedded at build time and cannot be changed after deployment

# Environment identifier (dev, test, prod)
# - 'dev' enables token authentication for development environment
# - 'test' enables token authentication for test environment  
# - 'prod' disables token authentication (public access)
NEXT_PUBLIC_ENVIRONMENT=prod

# ===================================
# AZURE STATIC WEB APPS CONFIGURATION
# ===================================
# These are configured in Azure Static Web Apps environment variables
# and used by the Azure Functions API at runtime

# Access token for environment protection
# For DEV environment: Set in Azure Static Web Apps as ACCESS_TOKEN
# For TEST environment: Set in Azure Static Web Apps as ACCESS_TOKEN
# For PROD environment: Not required (leave empty)
# Example: ACCESS_TOKEN=your-secure-token-here

# Environment identifier for Azure Functions
# Should match NEXT_PUBLIC_ENVIRONMENT for consistency
# Example: ENVIRONMENT=dev

# ===================================
# AZURE STORAGE (Existing)
# ===================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=

# ===================================
# AZURE TABLE STORAGE (Podcasts)
# ===================================
# Base URL for Azure Table Storage REST API (no trailing slash)
# Example: https://<account>.table.core.windows.net
AZURE_TABLE_STORAGE_URL=

# Azure Table Storage SAS token (without leading '?')
# Example: sv=2020-08-04&ss=t&srt=sco&sp=rl&...
AZURE_TABLE_SAS_TOKEN=

# Table name for DEV/TEST environment
AZURE_PODCAST_TABLE_DEV=podcastsdev

# Table name for PROD environment
AZURE_PODCAST_TABLE_PROD=podcasts

# ===================================
# YOUTUBE API (Video Section)
# ===================================
# YouTube Data API v3 key (server-side only — do NOT prefix with NEXT_PUBLIC_)
YOUTUBE_API_KEY=

# ===================================
# STRIPE (PDF Purchase Flow)
# ===================================
# Stripe secret key (server-side only — do NOT prefix with NEXT_PUBLIC_)
# Use sk_test_... for test mode, sk_live_... for production
STRIPE_SECRET_KEY=

# Stripe Price IDs (created in Stripe Dashboard for each PDF product)
STRIPE_PRICE_ID_BOOK=
STRIPE_PRICE_ID_WORKBOOK=
STRIPE_PRICE_ID_BUNDLE=

# Stripe webhook signing secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Public-facing site URL used for Stripe success/cancel redirect URLs
SITE_URL=https://fluxline.pro

# ===================================
# OTHER CONFIGURATIONS
# ===================================
# Add any other environment-specific variables here
